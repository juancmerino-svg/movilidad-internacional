<?xml version="1.0" encoding="utf-8"?>
<style xmlns="http://purl.org/net/xbiblio/csl" version="1.0" class="in-text" default-locale="es-ES">
  <info>
    <title>Revista de la Educación Superior — adaptación reproducible</title>
    <id>http://www.zotero.org/styles/revista-de-la-educacion-superior-reproducible</id>
    <link href="http://www.zotero.org/styles/revista-de-la-educacion-superior-reproducible" rel="self"/>
    <category citation-format="author-date"/>
    <category field="education"/>
    <summary>Estilo de trabajo reproducible basado en las directrices públicas vigentes de RESU: autor-fecha, año entre paréntesis en bibliografía, nombres de pila completos y regla 3–5 autores/et al. subsecuente.</summary>
    <updated>2026-09-04T00:00:00+00:00</updated>
  </info>

  <locale xml:lang="es">
    <terms>
      <term name="and">y</term>
      <term name="et-al">et al.</term>
      <term name="no date">s. f.</term>
    </terms>
  </locale>

  <macro name="author-cite">
    <names variable="author">
      <name form="short"
            delimiter=", "
            and="text"
            delimiter-precedes-last="never"
            et-al-min="6"
            et-al-use-first="1"
            et-al-subsequent-min="3"
            et-al-subsequent-use-first="1"/>
      <substitute>
        <text variable="title" form="short"/>
      </substitute>
    </names>
  </macro>

  <macro name="author-bib">
    <names variable="author">
      <name name-as-sort-order="all"
            sort-separator=", "
            initialize="false"
            delimiter=", "
            and="text"
            delimiter-precedes-last="always"/>
      <substitute>
        <text variable="title"/>
      </substitute>
    </names>
  </macro>

  <macro name="issued">
    <date variable="issued">
      <date-part name="year"/>
    </date>
  </macro>

  <macro name="title">
    <text variable="title"/>
  </macro>

  <macro name="container">
    <group delimiter=", ">
      <text variable="container-title" font-style="italic"/>
      <group delimiter="">
        <text variable="volume" font-style="italic"/>
        <text variable="issue" prefix="(" suffix=")"/>
      </group>
      <text variable="page"/>
    </group>
  </macro>

  <macro name="publisher">
    <group delimiter=", ">
      <text variable="publisher"/>
      <text variable="publisher-place"/>
    </group>
  </macro>

  <macro name="access">
    <choose>
      <if variable="DOI">
        <text variable="DOI" prefix="https://doi.org/"/>
      </if>
      <else-if variable="URL">
        <text variable="URL"/>
      </else-if>
    </choose>
  </macro>

  <citation et-al-min="6"
            et-al-use-first="1"
            et-al-subsequent-min="3"
            et-al-subsequent-use-first="1"
            disambiguate-add-year-suffix="true">
    <sort>
      <key macro="author-cite"/>
      <key macro="issued"/>
    </sort>
    <layout prefix="(" suffix=")" delimiter="; ">
      <group delimiter=", ">
        <text macro="author-cite"/>
        <text macro="issued"/>
      </group>
    </layout>
  </citation>

  <bibliography hanging-indent="true" et-al-min="100" et-al-use-first="100" line-spacing="1" entry-spacing="0">
    <sort>
      <key macro="author-bib"/>
      <key macro="issued"/>
      <key variable="title"/>
    </sort>
    <layout>
      <text macro="author-bib" suffix=". "/>
      <text macro="issued" prefix="(" suffix="). "/>
      <choose>
        <if type="article-journal article-magazine article-newspaper" match="any">
          <text macro="title" suffix=". "/>
          <text macro="container"/>
          <text macro="access" prefix=". "/>
        </if>
        <else-if type="report" match="any">
          <text macro="title" font-style="italic" suffix=". "/>
          <text macro="publisher"/>
          <text macro="access" prefix=". "/>
        </else-if>
        <else-if type="webpage post-weblog" match="any">
          <text macro="title" suffix=". "/>
          <text variable="container-title" font-style="italic"/>
          <text macro="access" prefix=". "/>
        </else-if>
        <else>
          <text macro="title" font-style="italic" suffix=". "/>
          <text macro="publisher"/>
          <text macro="access" prefix=". "/>
        </else>
      </choose>
    </layout>
  </bibliography>
</style>
